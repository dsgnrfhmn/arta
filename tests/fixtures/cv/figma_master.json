    {
      "id": "92103b43-0d97-4eff-b9ca-79da54905555",
      "kind": "heading",
      "text": "JANE ROE"
    },
    {
      "id": "a4e02fba-5646-4450-8673-d0d03dfa5ef2",
      "kind": "text",
      "text": "1986 born in Westfield | ZZ\nLives and works in Eastmoor | YY"
    },
    {
      "id": "4d43a311-ff0e-426b-bc7f-305ce0caf734",
      "kind": "heading",
      "text": "ABOUT"
    },
    {
      "id": "ddfeb4bf-edf7-4720-a760-66519ef3826f",
      "kind": "text",
      "text": "Jane Roe is a painter and textile artist. She works with tides, weather and woven structures, and with the slow, repeated gestures that both painting and weaving ask for."
    },
    {
      "id": "9b98b1dd-ec19-42c5-85fa-0d09881572ea",
      "kind": "heading",
      "text": "EDUCATION"
    },
    {
      "id": "69dd4efe-6986-4c14-975d-c95e565a7096",
      "kind": "text",
      "text": "2023\tSummer workshop \"Natural Dyes\", Weavers' Guild, Westfield | ZZ"
    },
    {
      "id": "2de026ea-c6ee-4fbd-bb63-340e37e0acb9",
      "kind": "text",
      "text": "2021\tStudio Fellowship, Riverside Art Institute, Eastmoor | YY"
    },
    {
      "id": "45c31fa6-dfb6-41b8-a411-48017775d408",
      "kind": "text",
      "text": "2019\tOnline course \"Writing about your own work\", Open Studio Network"
    },
    {
      "id": "d442758b-0bd9-449c-a9e4-88cdc2df2ca3",
      "kind": "text",
      "text": "2016\tMFA in Painting, Eastmoor School of Art | YY"
    },
    {
      "id": "d93650bc-7662-4789-9195-749d343d7247",
      "kind": "text",
      "text": "2014\tExchange semester, Coastal Art Academy, Westfield | ZZ"
    },
    {
      "id": "605832a3-c183-4930-b1a6-dbdda9953f03",
      "kind": "text",
      "text": "2011\tBA in Textile Design, Westfield University | ZZ"
    },
    {
      "id": "57f22663-c5ff-4d91-85bc-d9dbfe38e432",
      "kind": "text",
      "text": "2008\tFoundation year, City College of Art, Westfield | ZZ"
    },
    {
      "id": "a701a338-825f-4212-9310-4575a0c70b25",
      "kind": "text",
      "text": "2007\tEvening classes in life drawing, Harbour Hall, Westfield | ZZ"
    },
    {
      "id": "8091c271-5e65-4a34-92d4-07eb246d9e06",
      "kind": "heading",
      "text": "PROFESSIONAL EXPERIENCE"
    },
